# ---------------------------------------------------------------------------
# KeyNest master login (local prototype only).
#
# Copy this file to `.env.local` (which is git-ignored) and change the values.
# Generate a hash for your own master password with:
#
#     npm run hash -- "your master password"
#
# Format: pbkdf2:<iterations>:<salt base64>:<hash base64>
# (colons on purpose: Vite expands `$name` sequences inside .env files, so
#  the value must not contain dollar signs).
#
# The demo hash below corresponds to the password:  KeyNest!demo
# Replace it before storing anything real.
#
# SECURITY NOTE: every VITE_* variable is bundled into the browser JavaScript.
# Anyone who can open the built app can read this hash and attempt to crack it
# offline. This is acceptable for a personal local prototype only.
# ---------------------------------------------------------------------------
VITE_MASTER_USERNAME=admin
VITE_MASTER_PASSWORD_HASH=pbkdf2:310000:R2F2ZXJ6b3VzU2FsdDEyMzQ=:MtBNEjWYuSL8PVJL3/O1whwXHHayQuPMKzLYbng8EF4=

# Optional: Microsoft OneDrive / SharePoint integration (Cloud Excel Mode).
# Register a single-page application in Microsoft Entra ID, add
# http://localhost:5173 as an SPA redirect URI and grant the delegated
# permission "Files.ReadWrite". Leave blank to hide the cloud option.
VITE_MS_CLIENT_ID=
VITE_MS_AUTHORITY=https://login.microsoftonline.com/common
